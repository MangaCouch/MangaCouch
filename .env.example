# Compose example: docker compose --env-file .env -f deploy/compose.yaml up -d
# deploy/compose.yaml reads only the variables listed here. Paths inside the
# container (/data/state, /data/books) are fixed by the image.
# HTTP settings use defaults when unset. MAX_BYTES is persisted at initialization;
# deleting that variable later does not reset the stored archive limit.

# Image tag from ghcr.io/mangacouch/mangacouch; defaults to the newest release.
# `main` follows the development branch (rebuilt on every push to main that passes CI).
# MANGACOUCH_VERSION=X.Y.Z
# Host port published by compose; the container always listens on 8780.
MANGACOUCH_PORT=8780
# ORIGIN is the exact URL entered by clients, including the published port.
# Changing MANGACOUCH_PORT also requires changing MANGACOUCH_ORIGIN.
MANGACOUCH_ORIGIN=http://localhost:8780
# Additional comma-separated hosts; the public origin is always accepted.
# `*` accepts any host and turns off the DNS-rebinding check; remove it to turn the check back on.
# MANGACOUCH_ALLOWED_HOSTS=localhost,192.168.1.20
# Reverse proxies (IPs or networks, comma-separated) whose X-Forwarded-For names the client.
# REQUIRED behind a reverse proxy (Caddy, nginx, Traefik, ...): without it every client counts
# as the proxy's single address, and ten sign-in attempts from anyone within a minute lock
# everyone out until the minute is over. Use the address the container sees the proxy at: a
# proxy container in this Compose project, or a proxy on the host forwarding to the published
# port, both come from the project network (`docker network inspect deploy_default`, "Subnet").
# The server log names the address when a sign-in arrives with X-Forwarded-For from an
# unlisted proxy. See docs/install.md#behind-a-reverse-proxy for Caddy and nginx examples.
# MANGACOUCH_TRUSTED_PROXIES=172.18.0.0/16
# Largest upload the web app accepts, in bytes (default 2 GiB).
# MANGACOUCH_UPLOAD_BYTES=2147483648
# Disk budget of the cover and thumbnail cache, in bytes (default 20 GiB).
# MANGACOUCH_CACHE_BYTES=21474836480
# Largest archive accepted from an upload or the import/ folder, in bytes (default: unlimited).
# Downloads have their own limit (Maximum download size in source settings, default 32 GiB).
# To restore unlimited imports, stop the server and set limits.max_archive_bytes
# to null in state/runtime.json. Start the server with MAX_BYTES unset.
# MANGACOUCH_MAX_BYTES=34359738368
# Log detail in `docker logs`: debug, info (default), warning or error.
# MANGACOUCH_LOG_LEVEL=info
# Container bind-mount ownership; the service never defaults to root.
MANGACOUCH_UID=10001
MANGACOUCH_GID=10001
