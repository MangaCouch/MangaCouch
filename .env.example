# Compose example: docker compose --env-file .env -f deploy/compose.yaml up -d
# deploy/compose.yaml reads only the variables listed here. Paths inside the
# container (/data/state, /data/books) are fixed by the image.

# Image tag from ghcr.io/mangacouch/mangacouch; defaults to the newest release.
# MANGACOUCH_VERSION=0.1.0
# Host port published by compose; the container always listens on 8780.
MANGACOUCH_PORT=8780
# ORIGIN is the exact URL entered by clients, including the published port.
# Changing MANGACOUCH_PORT also requires changing MANGACOUCH_ORIGIN.
MANGACOUCH_ORIGIN=http://localhost:8780
# Additional comma-separated hosts; the public origin is always accepted.
# MANGACOUCH_ALLOWED_HOSTS=localhost,192.168.1.20
# MANGACOUCH_UPLOAD_BYTES=536870912
# MANGACOUCH_MAX_BYTES=34359738368
# Container bind-mount ownership; the service never defaults to root.
MANGACOUCH_UID=10001
MANGACOUCH_GID=10001
